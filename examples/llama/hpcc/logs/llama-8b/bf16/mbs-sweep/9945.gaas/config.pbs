#!/bin/bash
#PBS -N megatron-train
#PBS -l select=16:ngpus=8
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o megatron-train.log
#PBS -P gs_ccds_chen.wang
#PBS -q gpu_as

# ============================================================
# Configuration  ← edit this section
# ============================================================
export GPUS_PER_NODE=8      # must match ngpus above
export DTYPE=${DTYPE:-bf16}           # bf16 | fp16 | fp8
export ATTENTION_BACKEND=${ATTENTION_BACKEND:-fused}   # fused | flash

if [[ "$DTYPE" == "fp8" && "$ATTENTION_BACKEND" == "fused" ]]; then
    export ENABLE_FP8_ATTN=1
else
    export ENABLE_FP8_ATTN=0
fi

# Parallelism
export NUM_NODES=$(wc -l < "${PBS_NODEFILE}")
export TP_SIZE=${TP_SIZE:-1}
export PP_SIZE=${PP_SIZE:-1}
export CP_SIZE=${CP_SIZE:-1}
DP_SIZE=$(( NUM_NODES * GPUS_PER_NODE / (TP_SIZE * PP_SIZE) ))

# Training
export RECOMPUTE_LAYERS=${RECOMPUTE_LAYERS:-0}    # 0=disabled | N=recompute N layers per PP stage (full/uniform)
export PROFILE=${PROFILE:-0}             # 0=disabled | 1=enabled (NVTX markers, use with nsys profile)
export MICRO_BATCH_SIZE=${MICRO_BATCH_SIZE:-2}
export GLOBAL_BATCH_SIZE=${GLOBAL_BATCH_SIZE:-32768}
GRAD_ACCUMU_STEP=$(( GLOBAL_BATCH_SIZE / (MICRO_BATCH_SIZE * DP_SIZE) ))
export TRAIN_SAMPLES=${TRAIN_SAMPLES:-$(( GLOBAL_BATCH_SIZE * 5 ))}
export NUM_LAYERS=${NUM_LAYERS:-32}
export SEQ_LENGTH=${SEQ_LENGTH:-4096}

if [ $GRAD_ACCUMU_STEP -lt 2 ]; then
    export EMPTY_UNUSED_MEMORY_LEVEL=0
else
    export EMPTY_UNUSED_MEMORY_LEVEL=1
fi

# ============================================================
# Job setup  ← don't touch
# ============================================================
PROJ_DIR=$HOME/Megatron-LM
cd $PROJ_DIR

export MASTER_ADDR=$(head -1 "${PBS_NODEFILE}")
export MASTER_PORT=29500
export MEGATRON_PROFILE=0 MERGE_MEGATRON_PROFILE=1 MEGATRON_PROFILE_STACK=0
export TRACE_DIR=$SCRATCH/megatron_trace_${DTYPE}_dp${DP_SIZE}_pp${PP_SIZE}_tp${TP_SIZE}

module load cuda/13.0 gnu/gcc-12.3
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate megatron-lm

echo "====== Nodes ======"
cat $PBS_NODEFILE
echo "DP=$DP_SIZE  TP=$TP_SIZE  PP=$PP_SIZE  CP=$CP_SIZE  DTYPE=$DTYPE"

# Per-node GPU topology
mpirun --mca plm_rsh_agent pbs_tmrsh \
       -hostfile $PBS_NODEFILE -np $NUM_NODES -- bash -c '
    RANK=$PMI_RANK
    {
        echo "===== HOST: $(hostname) ====="
        echo "CPU affinity: $(taskset -cp $$)"
        nvidia-smi nvlink -s
        nvidia-smi topo -m
        nvidia-smi --query-gpu=index,uuid --format=csv,noheader
    } | sed "s/^/[node${RANK}] /"
'

export CUDA_VISIBLE_DEVICES=$(seq 0 $((GPUS_PER_NODE - 1)) | paste -sd ',')

# Per-job log directory for traceability
LOG_DIR="examples/llama/hpcc/logs/${PBS_JOBID}"
mkdir -p "$LOG_DIR"
cp examples/llama/hpcc/train_llama_hpcc.pbs "$LOG_DIR/config.pbs"
cp examples/llama/hpcc/train_llama_hpcc.sh "$LOG_DIR/config.sh"

# Save resolved values — captures any -v overrides (config.pbs only has defaults)
cat > "$LOG_DIR/params.env" <<EOF
GPUS_PER_NODE=$GPUS_PER_NODE
DTYPE=$DTYPE
ATTENTION_BACKEND=$ATTENTION_BACKEND
ENABLE_FP8_ATTN=$ENABLE_FP8_ATTN
TP_SIZE=$TP_SIZE
PP_SIZE=$PP_SIZE
CP_SIZE=$CP_SIZE
RECOMPUTE_LAYERS=$RECOMPUTE_LAYERS
PROFILE=$PROFILE
MICRO_BATCH_SIZE=$MICRO_BATCH_SIZE
GLOBAL_BATCH_SIZE=$GLOBAL_BATCH_SIZE
GRAD_ACCUMU_STEP=$GRAD_ACCUMU_STEP
EMPTY_UNUSED_MEMORY_LEVEL=$EMPTY_UNUSED_MEMORY_LEVEL
TRAIN_SAMPLES=$TRAIN_SAMPLES
NUM_LAYERS=$NUM_LAYERS
SEQ_LENGTH=$SEQ_LENGTH
NUM_NODES=$NUM_NODES
EOF

# ============================================================
# Launch
# ============================================================
mpirun --mca plm_rsh_agent pbs_tmrsh \
       -hostfile $PBS_NODEFILE -npernode 1 --bind-to none \
       -x SCRATCH \
       -x CUDA_VISIBLE_DEVICES \
       -x GPUS_PER_NODE -x NUM_NODES \
       -x MASTER_ADDR -x MASTER_PORT \
       -x DTYPE -x ATTENTION_BACKEND -x ENABLE_FP8_ATTN \
       -x TP_SIZE -x PP_SIZE -x CP_SIZE \
       -x MICRO_BATCH_SIZE -x GLOBAL_BATCH_SIZE -x EMPTY_UNUSED_MEMORY_LEVEL \
       -x TRAIN_SAMPLES -x NUM_LAYERS -x SEQ_LENGTH \
       -x RECOMPUTE_LAYERS \
       -x PROFILE \
       -x MEGATRON_PROFILE -x MERGE_MEGATRON_PROFILE -x MEGATRON_PROFILE_STACK -x TRACE_DIR \
       bash -c '
           echo "CPU affinity on $(hostname): $(taskset -cp $$)"
           module purge
           module load cuda/13.0 gnu/gcc-12.3
           eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
           conda activate megatron-lm
           bash examples/llama/hpcc/train_llama_hpcc.sh
       ' 2>&1 | tee "$LOG_DIR/train.log"
