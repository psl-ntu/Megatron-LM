#!/bin/bash
#PBS -N megatron-train
#PBS -l select=16:ngpus=8:ncpus=96:mem=1536gb
#PBS -l place=scatter
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o megatron-train.log
#PBS -P gs_ccds_chen.wang
#PBS -q gpu_as

# Config overrides for 70B-scale run
export GPUS_PER_NODE=8
export DTYPE=${DTYPE:-bf16}
export TP_SIZE=${TP_SIZE:-8}
export PP_SIZE=${PP_SIZE:-4}
export ENABLE_FSDP=1
export NUM_LAYERS=${NUM_LAYERS:-80}
export HIDDEN_SIZE=${HIDDEN_SIZE:-8192}
export FFN_HIDDEN_SIZE=${FFN_HIDDEN_SIZE:-28672}
export NUM_ATTENTION_HEADS=${NUM_ATTENTION_HEADS:-64}

export NCCL_IB_HCA=mlx5_0,mlx5_1,mlx5_2,mlx5_3,mlx5_4,mlx5_5,mlx5_8,mlx5_9

export MASTER_ADDR=$(head -1 "${PBS_NODEFILE}")
export MASTER_PORT=29500
export NUM_NODES=$(wc -l < "${PBS_NODEFILE}")
export CUDA_VISIBLE_DEVICES=$(seq 0 $((GPUS_PER_NODE - 1)) | paste -sd ',')

PROJ_DIR=$HOME/Megatron-LM
cd $PROJ_DIR

module load cuda/13.0 gnu/gcc-12.3
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate megatron-lm

echo "====== Nodes ======"
cat $PBS_NODEFILE

mpirun --mca plm_rsh_agent pbs_tmrsh \
       -hostfile $PBS_NODEFILE -npernode 1 --bind-to none \
       -x CUDA_VISIBLE_DEVICES -x GPUS_PER_NODE -x NUM_NODES \
       -x MASTER_ADDR -x MASTER_PORT \
       -x DTYPE -x TP_SIZE -x PP_SIZE -x ENABLE_FSDP \
       -x NUM_LAYERS -x HIDDEN_SIZE -x FFN_HIDDEN_SIZE -x NUM_ATTENTION_HEADS \
       -x NCCL_IB_HCA -x SCRATCH \
       bash -c '
           echo "[$(date +%T)] $(hostname): starting"
           module load cuda/13.0 gnu/gcc-12.3
           eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
           conda activate megatron-lm
           bash examples/llama/train.sh
       ' 2>&1 | tee train.log
